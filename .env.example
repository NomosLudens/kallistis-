# Supabase (frontend-safe public values)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenRouter (Cloudflare Worker only; never expose in the frontend)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cloudflare (optional for local/deploy tooling)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Security: Supabase keys exposed in Git history MUST be rotated.
# OPENROUTER_API_KEY must NEVER be sent to the frontend; use the Worker proxy.
